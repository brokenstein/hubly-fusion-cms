# --- Backend (Supabase) — required ---
# Same values on client and server. Publishable keys are safe to commit.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="your-project-ref"

# --- Optional ---
# Uptime Kuma API key, only attached to hosts in UPTIME_KUMA_ALLOWED_HOSTS.
UPTIME_KUMA_API_KEY=""
UPTIME_KUMA_ALLOWED_HOSTS="uptime.example.com"

# Enables AI refinement of Brand Kit extraction (optional; extraction works without it).
LOVABLE_API_KEY=""

# NOTE: SUPABASE_SERVICE_ROLE_KEY is NOT required. Nothing in the app needs it —
# admin user management runs through security-definer database functions instead.
